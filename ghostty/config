# Theme
theme = nightfly
background-opacity = 1
background-blur = true
background-blur-radius = 25
palette-generate = true
palette-harmonious = true
background-image = "background.jpg"
background-image-fit = cover
background-image-opacity = 0.1

# UI
title-report = true
window-theme = ghostty
unfocused-split-opacity = 0.55
split-divider-color = #524f67
confirm-close-surface = false
window-decoration = auto
# window-padding-x = 10
# window-padding-y = 10
# window-padding-balance = true

# Font
font-size = 14
font-family = Berkeley Mono
font-family = Ioskeley Mono
font-family = Symbols Nerd Font Mono
font-style = Regular
font-style-bold = ExtraBold
font-style-italic = SemiCondensed Oblique
font-style-bold-italic = Bold SemiCondensed Oblique

# Shell
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo,path

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# UX
confirm-close-surface = true
quit-after-last-window-closed = true
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# opt+shift+delete to delete to space
keybind = shift+alt+backspace=text:\x1b\x08
keybind = shift+alt+bracket_left=text:\x1b{
keybind = shift+alt+bracket_right=text:\x1b}
keybind = shift+space=text:\x20

# MacOS
macos-titlebar-style = tabs
macos-option-as-alt = true
# macos-shortcuts = allow
# fullscreen = non-native-visible-menu
macos-non-native-fullscreen = visible-menu
macos-icon = custom-style
macos-icon-ghost-color = #7fdbca
macos-icon-screen-color = #011627
# macos-icon = retro
# macos-icon = custom
# macos-custom-icon = ~/.config/ghostty/themes/tokyo-night.icns

# Mouse
mouse-hide-while-typing = true
# Fix stuttery scroll in tmux
mouse-scroll-multiplier = 0.5

# Updates
auto-update = download
auto-update-channel = stable

# Shaders
custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl
custom-shader = ~/.config/ghostty/shaders/ripple_rectangle_cursor.glsl
